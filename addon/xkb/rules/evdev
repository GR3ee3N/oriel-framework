// Extend system evdev rules with symbols/oriel(remote), mapping remote keys
// reported as Unidentified/keyCode 0 to keysyms recognized by WebKit.
// XKB_CONFIG_EXTRA_PATH selects these rules. Apply the mapping to every model
// because WPEPlatform uses explicit keymap names and ignores XKB_DEFAULT_OPTIONS.
! include %S/evdev

! model           = symbols
  *               = +oriel(remote)
